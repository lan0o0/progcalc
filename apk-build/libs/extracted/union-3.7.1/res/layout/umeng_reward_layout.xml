<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/umeng_reward_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 摇一摇图标 -->
    <ImageView
        android:id="@+id/umeng_reward_shake"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="280dp"
        android:scaleType="fitXY"
        android:src="@drawable/umeng_union_splash_shake"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

    <RelativeLayout
        android:id="@+id/umeng_reward_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <ImageView
            android:id="@+id/umeng_reward_sounds_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/umeng_reward_countdown_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/umeng_splash_skip"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:textColor="#CFFF"
            android:textSize="12dp"
            android:visibility="invisible"
            tools:ignore="RtlHardcoded,SpUsage"
            tools:text="@string/umeng_splash_skip_cd" />

        <TextView
            android:id="@+id/umeng_reward_close_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/umeng_splash_skip"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:text="@string/umeng_reward_close_cd"
            android:textColor="#CFFF"
            android:textSize="12dp"
            android:visibility="invisible"
            tools:ignore="RtlHardcoded,SpUsage"
            tools:text="@string/umeng_reward_close_cd" />

        <TextView
            android:id="@+id/umeng_reward_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_marginRight="12dp"
            android:layout_toStartOf="@id/umeng_reward_countdown_tv"
            android:layout_toLeftOf="@id/umeng_reward_countdown_tv"
            android:background="@drawable/umeng_splash_skip"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:textColor="#CFFF"
            android:textSize="12dp"
            tools:ignore="RelativeOverlap,SpUsage"
            tools:text="去体验15s，立即领奖" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/umeng_reward_ad_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="13dp"
        android:layout_marginLeft="13dp"
        android:layout_marginEnd="13dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/umeng_reward_ad_info_layout_bg">

        <!-- 体验任务提示区域，仅体验模式显示 -->
        <LinearLayout
            android:id="@+id/umeng_reward_ad_info_tips_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/umeng_reward_ad_info_tips_layout_bg"
            android:visibility="gone">

            <TextView
                android:id="@+id/umeng_reward_ad_info_tips_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="11dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#CC000000"
                android:textSize="20dp"
                android:textStyle="bold"
                tools:ignore="SpUsage"
                tools:text="去体验15s，立即领奖" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/umeng_reward_ad_info_detail_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/umeng_reward_ad_info_tips_layout">

            <ImageView
                android:id="@+id/umeng_reward_ad_info_iv"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginStart="24dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="20dp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/umeng_reward_ad_info_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/umeng_reward_ad_info_iv"
                android:layout_marginStart="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="24dp"
                android:layout_marginRight="24dp"
                android:layout_toEndOf="@id/umeng_reward_ad_info_iv"
                android:layout_toRightOf="@id/umeng_reward_ad_info_iv"
                android:maxLines="1"
                android:textColor="#CC000000"
                android:textSize="20sp"
                tools:text="a" />

            <TextView
                android:id="@+id/umeng_reward_ad_info_content_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/umeng_reward_ad_info_iv"
                android:layout_marginStart="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginEnd="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="2dp"
                android:layout_toEndOf="@id/umeng_reward_ad_info_iv"
                android:layout_toRightOf="@id/umeng_reward_ad_info_iv"
                android:maxLines="2"
                android:textColor="#99000000"
                android:textSize="16sp"
                tools:text="b" />

            <Button
                android:id="@+id/umeng_reward_ad_info_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_below="@id/umeng_reward_ad_info_iv"
                android:layout_centerVertical="true"
                android:layout_marginStart="24dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/umeng_reward_ad_info_btn_bg"
                android:text="@string/umeng_ad_info_click_open"
                android:textColor="@android:color/white"
                android:textSize="20sp" />
        </RelativeLayout>
    </RelativeLayout>

    <ImageView
        android:id="@+id/umeng_reward_mark"
        android:layout_width="22dp"
        android:layout_height="10dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/umeng_union_splash_mark"
        tools:ignore="ContentDescription" />
</FrameLayout>
