<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/umeng_reward_tips_root"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@android:color/transparent">

    <ScrollView
        android:id="@+id/umeng_reward_tips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <RelativeLayout
            android:id="@+id/umeng_reward_tips_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/umeng_reward_ad_info_icon_bg">

            <!-- 默认标题（如"您还没有完成任务"），可选 -->
            <TextView
                android:id="@+id/umeng_reward_tips_default_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="23dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="53dp"
                android:layout_marginEnd="23dp"
                android:layout_marginRight="23dp"
                android:gravity="center"
                android:textColor="#CC000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 动态标题 -->
            <TextView
                android:id="@+id/umeng_reward_tips_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/umeng_reward_tips_default_title_tv"
                android:layout_marginStart="23dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="60dp"
                android:layout_marginEnd="23dp"
                android:layout_marginRight="23dp"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#CC000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 广告信息区域，可选 -->
            <RelativeLayout
                android:id="@+id/umeng_reward_tips_ad_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/umeng_reward_tips_title_tv"
                android:layout_marginStart="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/umeng_reward_experience_tips_ad_info_layout_bg"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/umeng_reward_tips_ad_info_iv"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/umeng_reward_ad_info_icon_bg"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/umeng_reward_tips_ad_info_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/umeng_reward_tips_ad_info_iv"
                    android:layout_marginStart="9dp"
                    android:layout_marginLeft="9dp"
                    android:layout_toEndOf="@id/umeng_reward_tips_ad_info_iv"
                    android:layout_toRightOf="@id/umeng_reward_tips_ad_info_iv"
                    android:maxLines="1"
                    android:textColor="#CC000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/umeng_reward_tips_ad_info_content_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/umeng_reward_tips_ad_info_iv"
                    android:layout_marginStart="9dp"
                    android:layout_marginLeft="9dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginRight="14dp"
                    android:layout_toEndOf="@id/umeng_reward_tips_ad_info_iv"
                    android:layout_toRightOf="@id/umeng_reward_tips_ad_info_iv"
                    android:maxLines="2"
                    android:textColor="#99000000"
                    android:textSize="12sp" />
            </RelativeLayout>

            <!-- 确认按钮 -->
            <Button
                android:id="@+id/umeng_reward_tips_ok_btn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_below="@id/umeng_reward_tips_ad_info_layout"
                android:layout_marginStart="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/umeng_reward_experience_tips_btn_bg"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 取消按钮，可选 -->
            <Button
                android:id="@+id/umeng_reward_tips_cancel_btn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_below="@id/umeng_reward_tips_ok_btn"
                android:layout_marginStart="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/umeng_reward_experience_tips_btn_giveup_bg"
                android:text="@string/umeng_ad_reward_btn_cancel"
                android:textColor="#66000000"
                android:textSize="14sp"
                android:visibility="gone" />

        </RelativeLayout>
    </ScrollView>

    <!-- 顶部礼物图标 -->
    <ImageView
        android:id="@+id/umeng_reward_tips_gift_iv"
        android:layout_width="94dp"
        android:layout_height="94dp"
        android:layout_gravity="top|center"
        android:background="@drawable/umeng_union_reward_gift"
        tools:ignore="ContentDescription" />
</FrameLayout>
