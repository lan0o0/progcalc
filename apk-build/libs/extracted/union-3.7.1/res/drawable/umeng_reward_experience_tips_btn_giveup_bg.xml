<!-- res/drawable/btn_background.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FFE6E6" /> <!-- 点击时颜色 -->
            <stroke android:width="1dp" android:color="#EB9595" />
            <corners android:radius="144dp" />
        </shape>
    </item>
    <!-- 默认状态 -->
    <item>
        <shape>
            <solid android:color="#FFFFFF" /> <!-- 默认颜色 -->
            <stroke android:width="1dp" android:color="#EB9595" />
            <corners android:radius="144dp" />
        </shape>
    </item>
</selector>
